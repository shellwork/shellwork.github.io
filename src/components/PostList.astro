---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../lib/utils';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <time class="faint" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date, 'short')}
        </time>
        <div>
          <a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
          {post.data.description && <p class="muted">{post.data.description}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  time {
    font-size: 0.85rem;
    padding-top: 0.12rem;
    font-variant-numeric: tabular-nums;
  }

  a {
    font-weight: 600;
    color: var(--text);
  }

  a:hover {
    color: var(--accent);
  }

  p {
    margin: 0.1rem 0 0;
    font-size: 0.93rem;
  }

  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
